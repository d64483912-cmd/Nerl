# Database Configuration
DATABASE_URL=postgresql://neondb_owner:your_password@your_host/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:your_password@your_host/neondb?sslmode=require

# Alternative Postgres Variables (Vercel format)
POSTGRES_URL=postgresql://neondb_owner:your_password@your_host/neondb?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://neondb_owner:your_password@your_host/neondb?sslmode=require
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=your_host
POSTGRES_DATABASE=neondb

# AI Service API Keys
MISTRAL_API_KEY=your_mistral_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Embedding Configuration
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIM=384

# Frontend Configuration
VITE_API_URL=http://localhost:3001/api

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Rate limiting and caching
REDIS_URL=redis://localhost:6379
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000
